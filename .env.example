NODE_ENV="development"
PORT=3000
LOG_LEVEL="debug"

# Milliseconds: receiving headers, receiving the whole request, and API response.
HTTP_HEADERS_TIMEOUT_MS=5000
HTTP_REQUEST_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=10000
# HTTP drain must be shorter than the overall shutdown deadline.
HTTP_DRAIN_TIMEOUT_MS=25000
SHUTDOWN_TIMEOUT_MS=30000

# On-demand /ready probes share one pool lease and cache their result briefly.
DB_READINESS_TIMEOUT_MS=1000
DB_READINESS_CACHE_MS=1000
# Startup verifies migration history; it never applies migrations.
DB_MIGRATION_CHECK_TIMEOUT_MS=5000

# Exact rolling window per client, enforced independently by each API process.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
RATE_LIMIT_MAX_CLIENTS=10000
# RATE_LIMIT_MAX * RATE_LIMIT_MAX_CLIENTS must not exceed 2000000.

# Empty means direct access: forwarding headers cannot override client identity.
# Behind an ingress, list only its actual IPs/CIDRs (comma-separated).
TRUST_PROXY=""

CORS_ORIGINS="http://localhost:3000"
CORS_METHODS="GET,POST,PUT,DELETE,PATCH,OPTIONS"
CORS_ALLOWED_HEADERS="content-type,authorization,x-requested-with"
CORS_EXPOSED_HEADERS="authorization,set-cookie"
CORS_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=86400

DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="root"
DB_DATABASE="test"

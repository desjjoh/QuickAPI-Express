# Required runtime settings.
NODE_ENV="development"
PORT=3000
LOG_LEVEL="debug"

# Persistent local development MySQL; start it with npm run infra:up.
# Local-only credentials match docker-compose.yaml. Never use them in production.
DB_HOST="127.0.0.1"
DB_PORT=3309
DB_USER="app"
DB_PASSWORD="app"
DB_DATABASE="quickapi"

# Optional settings below use application defaults when omitted/commented out.
# Uncomment a setting to override it; restart the application after changes.
# Existing explicit local overrides remain active in .env.

# Optional database capacity and deadlines; defaults shown below.
# Limits are per process. Queue limit 0 rejects immediately when the pool is full.
# DB_POOL_CONNECTION_LIMIT=10
# DB_POOL_QUEUE_LIMIT=50
# Acquisition covers waiting for a lease, not execution or cancellation of SQL.
# DB_POOL_ACQUIRE_TIMEOUT_MS=1000
# Connection setup includes the full handshake, including TLS/authentication.
# DB_CONNECT_TIMEOUT_MS=10000
# TLS defaults off locally. Enable deliberately for encrypted deployments.
# TLS always verifies the CA chain and DNS DB_HOST identity (minimum TLS 1.2).
# DB_SSL=false
# Optional mounted PEM CA bundle; omit to use Node's default trust roots.
# Requires DB_SSL=true and a DNS hostname matching the certificate.
# DB_SSL_CA_FILE="/run/secrets/mysql-ca.pem"

# Application metadata: defaults to the current package.json name and version.
# APP_NAME="quickapi-express"
# APP_VERSION="1.0.0"

# Operational endpoints: defaults are true in development/test, false in production.
# Example values below show production defaults; only true/false are accepted.
# DOCS_ENABLED=false
# DIAGNOSTICS_ENABLED=false
# METRICS_ENABLED=false
# Enabled metrics/diagnostics require proxy/private-network access restrictions.

# Transport receive deadlines and response deadline, in milliseconds.
# Defaults: headers 5000; entire request 10000; API response 10000.
# Header timeout must not exceed the entire-request timeout.
# HTTP_HEADERS_TIMEOUT_MS=5000
# HTTP_REQUEST_TIMEOUT_MS=10000
# REQUEST_TIMEOUT_MS=10000

# Shutdown defaults in milliseconds; drain must be shorter than total shutdown.
# HTTP_DRAIN_TIMEOUT_MS=25000
# SHUTDOWN_TIMEOUT_MS=30000

# Database probe/cache defaults in milliseconds; /ready shares one pool lease.
# DB_READINESS_TIMEOUT_MS=1000
# DB_READINESS_CACHE_MS=1000
# Startup checks migration history but never applies migrations. Default: 5000ms.
# DB_MIGRATION_CHECK_TIMEOUT_MS=5000

# Exact rolling-window defaults, enforced independently by each API process.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=200
# RATE_LIMIT_MAX_CLIENTS=10000
# RATE_LIMIT_MAX * RATE_LIMIT_MAX_CLIENTS must not exceed 2000000.

# Optional item mutation idempotency policy; requests without keys are unchanged.
# Retention is fixed at 24 hours; lifecycle-owned cleanup runs hourly (no override).
# UTF-8 response bytes: default/hard ceiling 65536; may be reduced, never exceeded.
# IDEMPOTENCY_MAX_RESPONSE_BYTES=65536
# Cleanup defaults: 100 rows per batch, at most 10 batches per sweep.
# Bounds: batch size 1..1000; batches 1..100; product must not exceed 10000.
# IDEMPOTENCY_CLEANUP_BATCH_SIZE=100
# IDEMPOTENCY_CLEANUP_MAX_BATCHES=10

# Proxy trust defaults to empty: forwarding cannot override client identity.
# Behind an ingress, list only its actual IPs/CIDRs, separated by commas.
# TRUST_PROXY=""

# CORS defaults: exact origins only; lists are comma-separated.
# CORS_ORIGINS="http://localhost:3000"
# CORS_METHODS="GET,POST,PUT,DELETE,PATCH,OPTIONS"
# CORS_ALLOWED_HEADERS="content-type,authorization,x-requested-with,idempotency-key"
# CORS_EXPOSED_HEADERS="authorization,set-cookie"
# CORS_CREDENTIALS=true
# Preflight cache duration in seconds; default 86400, range 0..86400.
# CORS_MAX_AGE_SECONDS=86400

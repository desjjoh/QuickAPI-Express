# Required test runtime settings. Port 0 uses an ephemeral listener; silent suppresses logs.
NODE_ENV="test"
PORT="0"
LOG_LEVEL="silent"

# Required disposable database settings; matches docker-compose.test.yml (port 3318).
# Prepare this schema before database-backed tests; these tests can delete its data.
# Keep NODE_ENV=test and a schema name ending in _disposable_test.
DB_HOST="127.0.0.1"
DB_PORT="3318"
DB_USER="quickapi_test_user"
DB_PASSWORD="quickapi_test_password"
DB_DATABASE="quickapi_disposable_test"

# Optional settings below use application defaults when omitted/commented out.
# Uncomment a setting to override it; restart the application after changes.

# Application metadata: defaults to the current package.json name and version.
# APP_NAME="quickapi-express"
# APP_VERSION="1.0.0"

# Operational endpoints: defaults are true in development/test, false in production.
# Examples below show test defaults; only true/false are accepted.
# DOCS_ENABLED=true
# DIAGNOSTICS_ENABLED=true
# METRICS_ENABLED=true
# Enabled metrics/diagnostics require proxy/private-network access restrictions.

# Transport receive deadlines and response deadline, in milliseconds.
# Defaults: headers 5000; entire request 10000; API response 10000.
# Header timeout must not exceed the entire-request timeout.
# HTTP_HEADERS_TIMEOUT_MS=5000
# HTTP_REQUEST_TIMEOUT_MS=10000
# REQUEST_TIMEOUT_MS=10000

# Shutdown defaults in milliseconds; drain must be shorter than total shutdown.
# HTTP_DRAIN_TIMEOUT_MS=25000
# SHUTDOWN_TIMEOUT_MS=30000

# Database probe/cache defaults in milliseconds; /ready shares one pool lease.
# DB_READINESS_TIMEOUT_MS=1000
# DB_READINESS_CACHE_MS=1000
# Startup checks migration history but never applies migrations. Default: 5000ms.
# DB_MIGRATION_CHECK_TIMEOUT_MS=5000

# Exact rolling-window defaults, enforced independently by each API process.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=200
# RATE_LIMIT_MAX_CLIENTS=10000
# RATE_LIMIT_MAX * RATE_LIMIT_MAX_CLIENTS must not exceed 2000000.

# Proxy trust defaults to empty: forwarding cannot override client identity.
# Behind an ingress, list only its actual IPs/CIDRs, separated by commas.
# TRUST_PROXY=""

# CORS defaults: exact origins only; lists are comma-separated.
# CORS_ORIGINS="http://localhost:3000"
# CORS_METHODS="GET,POST,PUT,DELETE,PATCH,OPTIONS"
# CORS_ALLOWED_HEADERS="content-type,authorization,x-requested-with"
# CORS_EXPOSED_HEADERS="authorization,set-cookie"
# CORS_CREDENTIALS=true
# Preflight cache duration in seconds; default 86400, range 0..86400.
# CORS_MAX_AGE_SECONDS=86400

# Optional test-helper setting: extra permitted database hosts, comma-separated.
# Default: empty. Only allow hosts serving a dedicated disposable test schema.
# TEST_DB_ALLOWED_HOSTS=""
